# the url that the application will be accessible at, used for generating play Url with the correct host and port. If you are using a reverse proxy, this should be the public URL of the application.
BASE_URL=http://localhost:3000

# Jellyfin Configuration
JELLYFIN_URL=http://localhost:8096
JELLYFIN_USERNAME=your_jellyfin_username
JELLYFIN_API_KEY=your_jellyfin_api_key

# Navidrome Configuration
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USERNAME=your_navidrome_username
NAVIDROME_PASSWORD=your_navidrome_password

# JWT Configuration
# Use separate secrets for owner (authentication) and consumer (song tokens) for better security
JWT_SECRET_OWNER=your_owner_jwt_secret_key
JWT_SECRET_CONSUMER=your_consumer_jwt_secret_key

### OPTIONAL Environment Variables ###
# Token Configuration
TOKEN_EXPIRY_MINUTES=1440
TOKEN_USAGE_LIMIT=1

# Data Storage Configuration
DATA_DIR=/data
SONG_DOWNLOAD_DIR=/data/songs

# Basic Auth Configuration
AUTH_USERNAME=admin
AUTH_PASSWORD=some-secure-password-123-2i4hojnadolfgh # default is "password"

# Application Configuration
PORT=3000
NODE_ENV=development
