{
  "name": "jelly-public-music-share",
  "version": "0.2.0",
  "description": "A self-hosted music sharing platform for the Reddit r/selfhost community",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon --exec ts-node src/index.ts",
    "build": "npm run build:server",
    "build:server": "tsc",
    "db:push": "DATA_DIR=./data npx drizzle-kit push --config=src/drizzle.config.ts",
    "db:generate": "DATA_DIR=./data npx drizzle-kit generate --config=src/drizzle.config.ts",
    "db:migrate": "DATA_DIR=./data npx drizzle-kit migrate --config=src/drizzle.config.ts"
  },
  "keywords": [
    "music",
    "sharing",
    "selfhost",
    "express",
    "typescript"
  ],
  "author": "Jelly Team",
  "license": "MIT",
  "dependencies": {
    "@jellyfin/sdk": "^0.13.0",
    "axios": "^1.15.2",
    "better-sqlite3": "^12.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.39",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.47.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}
